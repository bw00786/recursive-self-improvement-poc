APP_ENV=development

# Database — Postgres in docker-compose; SQLite works for local dev:
# DATABASE_URL=sqlite:///./rail.db
DATABASE_URL=postgresql+psycopg://rail:rail@localhost:5432/rail

# LLM — any Qwen3-family (or other) model served by Ollama. Never hard-coded.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# MOCK_LLM: "auto" (default) uses a deterministic mock when Ollama is unreachable,
# so the full loop runs offline. "true" forces mock, "false" forces Ollama.
MOCK_LLM=auto

# Observability (optional — the app runs fine without Langfuse)
LANGFUSE_ENABLED=false
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_ENABLED=true

# Sandbox
SANDBOX_MODE=auto            # auto | docker | local
SANDBOX_IMAGE=rail-sandbox:latest
SANDBOX_CPU_LIMIT=2
SANDBOX_MEMORY_LIMIT=4g
SANDBOX_TIMEOUT_SECONDS=300

# Promotion gate
REQUIRE_HUMAN_APPROVAL=true
HARD_MAX_LATENCY_SECONDS=30
MIN_SCORE_IMPROVEMENT=0.5
